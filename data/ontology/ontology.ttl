@prefix : <https://everythingisasign.com/ontology/eias-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://everythingisasign.com/ontology/eias-ontology#> .

<https://everythingisasign.com/ontology/eias-ontology> rdf:type owl:Ontology ;
                                                        owl:versionIRI <https://everythingisasign.com/ontology/eias-ontology/1.0.0> ;
                                                        owl:imports <http://www.w3.org/2004/02/skos/core> ,
                                                                    <http://www.w3.org/2008/05/skos-xl> ;
                                                        <http://purl.org/dc/terms/creator> "Emilio Enrique Suárez Hode" ;
                                                        rdfs:comment "'Everything = a Sign' Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  https://everythingisasign.com/ontology/eias-ontology#abstract
:abstract rdf:type owl:AnnotationProperty .


###  https://everythingisasign.com/ontology/eias-ontology#description
:description rdf:type owl:AnnotationProperty .


###  https://everythingisasign.com/ontology/eias-ontology#introduction
:introduction rdf:type owl:AnnotationProperty .


###  https://everythingisasign.com/ontology/eias-ontology#rawText
:rawText rdf:type owl:AnnotationProperty .


###  https://everythingisasign.com/ontology/eias-ontology#synopsis
:synopsis rdf:type owl:AnnotationProperty .


###  https://everythingisasign.com/ontology/eias-ontology#taxonomy
:taxonomy rdf:type owl:AnnotationProperty ;
          rdfs:label "taxonomy" .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdfs:subPropertyOf owl:topObjectProperty .


###  https://everythingisasign.com/ontology/eias-ontology#citesAuthor
:citesAuthor rdf:type owl:ObjectProperty ;
             owl:inverseOf :isCitedInWork ;
             rdfs:domain :Work ;
             rdfs:range :Agent .


###  https://everythingisasign.com/ontology/eias-ontology#citesWork
:citesWork rdf:type owl:ObjectProperty ;
           owl:inverseOf :isCitedByWork ;
           rdf:type owl:IrreflexiveProperty ;
           rdfs:domain :Work ;
           rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#containedWithinWork
:containedWithinWork rdf:type owl:ObjectProperty ;
                     owl:inverseOf :containsWork ;
                     rdfs:domain :Work ;
                     rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#containsWork
:containsWork rdf:type owl:ObjectProperty ;
              rdfs:domain :Work ;
              rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#creatorOf
:creatorOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasCreator ;
           rdf:type owl:IrreflexiveProperty ;
           rdfs:domain :Agent ;
           rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#hasCreator
:hasCreator rdf:type owl:ObjectProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Work ;
            rdfs:range :Agent .


###  https://everythingisasign.com/ontology/eias-ontology#hasFieldOfStudy
:hasFieldOfStudy rdf:type owl:ObjectProperty ;
                 rdfs:domain :Work ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://everythingisasign.com/ontology/eias-ontology#hasMaterial
:hasMaterial rdf:type owl:ObjectProperty ;
             rdfs:domain :Work ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://everythingisasign.com/ontology/eias-ontology#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           owl:inverseOf :memberOf ;
           rdfs:domain :Organization ;
           rdfs:range :Person .


###  https://everythingisasign.com/ontology/eias-ontology#hasMethod
:hasMethod rdf:type owl:ObjectProperty ;
           rdfs:domain :Work ;
           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://everythingisasign.com/ontology/eias-ontology#hasTopic
:hasTopic rdf:type owl:ObjectProperty ;
          rdfs:domain :Work ;
          rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://everythingisasign.com/ontology/eias-ontology#hasWorkType
:hasWorkType rdf:type owl:ObjectProperty ;
             rdfs:domain :Work ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://everythingisasign.com/ontology/eias-ontology#introducesTopic
:introducesTopic rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasTopic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relation to assert a topics first introduction / mention." .


###  https://everythingisasign.com/ontology/eias-ontology#isCitedByWork
:isCitedByWork rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Work ;
               rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#isCitedInWork
:isCitedInWork rdf:type owl:ObjectProperty ;
               rdfs:range :Work .


###  https://everythingisasign.com/ontology/eias-ontology#memberOf
:memberOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Person ;
          rdfs:range :Organization .


#################################################################
#    Data properties
#################################################################

###  https://everythingisasign.com/ontology/eias-ontology#DOI
:DOI rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf :Identifier ;
     rdfs:domain :TextualWork ;
     rdfs:range xsd:string .


###  https://everythingisasign.com/ontology/eias-ontology#ISBN
:ISBN rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf :Identifier ;
      rdfs:domain :Work ;
      rdfs:range xsd:string .


###  https://everythingisasign.com/ontology/eias-ontology#ISBN_10
:ISBN_10 rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :ISBN .


###  https://everythingisasign.com/ontology/eias-ontology#ISBN_13
:ISBN_13 rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :ISBN .


###  https://everythingisasign.com/ontology/eias-ontology#Identifier
:Identifier rdf:type owl:DatatypeProperty .


###  https://everythingisasign.com/ontology/eias-ontology#Language
:Language rdf:type owl:DatatypeProperty .


###  https://everythingisasign.com/ontology/eias-ontology#ORCID
:ORCID rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf :Identifier ;
       rdfs:domain :Person ;
       rdfs:range xsd:string .


###  https://everythingisasign.com/ontology/eias-ontology#ObjectNumber
:ObjectNumber rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :Identifier .


###  https://everythingisasign.com/ontology/eias-ontology#URL
:URL rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf :Identifier .


###  https://everythingisasign.com/ontology/eias-ontology#publicationDate
:publicationDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Work ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:unionOf ( xsd:date
                                            xsd:gYear
                                          )
                            ] ;
                 rdfs:comment "Syntax: YYYY-MM-DD or YYYY" .


###  https://everythingisasign.com/ontology/eias-ontology#releaseYear
:releaseYear rdf:type owl:DatatypeProperty ;
             rdfs:domain :Work ;
             rdfs:range xsd:gYear .


###  https://everythingisasign.com/ontology/eias-ontology#wikidataQID
:wikidataQID rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :Identifier ;
             rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#List
rdf:List rdfs:subClassOf :SKOS_Entity .


###  http://www.w3.org/2004/02/skos/core#Collection
<http://www.w3.org/2004/02/skos/core#Collection> rdfs:subClassOf :SKOS_Entity .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdfs:subClassOf :SKOS_Entity .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdfs:subClassOf :SKOS_Entity .


###  http://www.w3.org/2008/05/skos-xl#Label
<http://www.w3.org/2008/05/skos-xl#Label> rdfs:subClassOf :SKOS_Entity .


###  https://everythingisasign.com/ontology/eias-ontology#Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf :Entity .


###  https://everythingisasign.com/ontology/eias-ontology#DocumentTypeConcept
:DocumentTypeConcept rdf:type owl:Class ;
                     rdfs:subClassOf :HELPER .


###  https://everythingisasign.com/ontology/eias-ontology#Entity
:Entity rdf:type owl:Class ;
        rdfs:subClassOf :OWL_Entity .


###  https://everythingisasign.com/ontology/eias-ontology#FieldOfStudyConcept
:FieldOfStudyConcept rdf:type owl:Class ;
                     rdfs:subClassOf :HELPER .


###  https://everythingisasign.com/ontology/eias-ontology#HELPER
:HELPER rdf:type owl:Class .


###  https://everythingisasign.com/ontology/eias-ontology#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf :Entity .


###  https://everythingisasign.com/ontology/eias-ontology#MaterialConcept
:MaterialConcept rdf:type owl:Class ;
                 rdfs:subClassOf :HELPER .


###  https://everythingisasign.com/ontology/eias-ontology#MethodConcept
:MethodConcept rdf:type owl:Class ;
               rdfs:subClassOf :HELPER .


###  https://everythingisasign.com/ontology/eias-ontology#MultimediaWork
:MultimediaWork rdf:type owl:Class ;
                rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#OWL_Entity
:OWL_Entity rdf:type owl:Class .


###  https://everythingisasign.com/ontology/eias-ontology#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf :Agent .


###  https://everythingisasign.com/ontology/eias-ontology#PerformativeWork
:PerformativeWork rdf:type owl:Class ;
                  rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf :Agent ;
        owl:disjointWith :Work .


###  https://everythingisasign.com/ontology/eias-ontology#PhysicalWork
:PhysicalWork rdf:type owl:Class ;
              rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#SKOS_Entity
:SKOS_Entity rdf:type owl:Class .


###  https://everythingisasign.com/ontology/eias-ontology#SonicWork
:SonicWork rdf:type owl:Class ;
           rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#TextualWork
:TextualWork rdf:type owl:Class ;
             rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#TopicConcept
:TopicConcept rdf:type owl:Class ;
              rdfs:subClassOf :HELPER .


###  https://everythingisasign.com/ontology/eias-ontology#VisualWork
:VisualWork rdf:type owl:Class ;
            rdfs:subClassOf :Work .


###  https://everythingisasign.com/ontology/eias-ontology#Work
:Work rdf:type owl:Class ;
      rdfs:subClassOf :Entity .


